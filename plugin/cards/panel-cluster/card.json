{
  "name": "panel-cluster",
  "kind": "py",
  "deterministic": true,
  "purpose": "Draw a cluster panel as dark and light SVG in the Board look (or blueprint, paper): a graph of clusters: dot clouds with a label pill each, faint links between them.",
  "examples": [
    "draw a cluster panel",
    "a cluster diagram of my project",
    "a graph of clusters: dot clouds with a label pill each, faint links between them"
  ],
  "inputs": {
    "type": "object",
    "required": [
      "out",
      "title",
      "data"
    ],
    "additionalProperties": false,
    "properties": {
      "out": {
        "type": "string",
        "format": "newpath",
        "description": "the file stem: STEM-dark.svg and STEM-light.svg are written"
      },
      "title": {
        "type": "string",
        "minLength": 1,
        "maxLength": 40
      },
      "style": {
        "enum": [
          "board",
          "blueprint",
          "paper"
        ],
        "default": "board"
      },
      "stat": {
        "type": "string",
        "maxLength": 24
      },
      "foot": {
        "type": "string",
        "maxLength": 70
      },
      "w": {
        "type": "integer",
        "minimum": 420,
        "maximum": 2400,
        "default": 640
      },
      "h": {
        "type": "integer",
        "minimum": 260,
        "maximum": 1600,
        "default": 400
      },
      "data": {
        "type": "object",
        "properties": {
          "clusters": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 16
                },
                "n": {
                  "type": "number",
                  "minimum": 1,
                  "maximum": 60
                }
              },
              "required": [
                "label"
              ],
              "additionalProperties": false
            },
            "minItems": 2,
            "maxItems": 8
          },
          "links": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": 0,
                "maximum": 7
              },
              "minItems": 2,
              "maxItems": 2
            },
            "minItems": 0,
            "maxItems": 12
          }
        },
        "required": [
          "clusters"
        ],
        "additionalProperties": false,
        "description": "the cluster panel's data: clusters, links"
      }
    }
  },
  "creates": [
    "$out-dark.svg",
    "$out-light.svg"
  ]
}

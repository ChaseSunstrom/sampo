{
  "name": "panel-lanes",
  "kind": "py",
  "deterministic": true,
  "purpose": "Draw a lanes panel as dark and light SVG in the Board look (or blueprint, paper): pipeline lanes: rails with stations, a cart on each lane at its stage.",
  "examples": [
    "draw a lanes panel",
    "a lanes diagram of my project",
    "pipeline lanes: rails with stations, a cart on each lane at its stage"
  ],
  "inputs": {
    "type": "object",
    "required": [
      "out",
      "title",
      "data"
    ],
    "additionalProperties": false,
    "properties": {
      "out": {
        "type": "string",
        "format": "newpath",
        "description": "the file stem: STEM-dark.svg and STEM-light.svg are written"
      },
      "title": {
        "type": "string",
        "minLength": 1,
        "maxLength": 40
      },
      "style": {
        "enum": [
          "board",
          "blueprint",
          "paper"
        ],
        "default": "board"
      },
      "stat": {
        "type": "string",
        "maxLength": 24
      },
      "foot": {
        "type": "string",
        "maxLength": 70
      },
      "w": {
        "type": "integer",
        "minimum": 420,
        "maximum": 2400,
        "default": 640
      },
      "h": {
        "type": "integer",
        "minimum": 260,
        "maximum": 1600,
        "default": 400
      },
      "data": {
        "type": "object",
        "properties": {
          "stages": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 10
            },
            "minItems": 2,
            "maxItems": 7
          },
          "lanes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 16
                },
                "at": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 6
                }
              },
              "required": [
                "label",
                "at"
              ],
              "additionalProperties": false
            },
            "minItems": 1,
            "maxItems": 6
          }
        },
        "required": [
          "stages",
          "lanes"
        ],
        "additionalProperties": false,
        "description": "the lanes panel's data: stages, lanes"
      }
    }
  },
  "creates": [
    "$out-dark.svg",
    "$out-light.svg"
  ]
}

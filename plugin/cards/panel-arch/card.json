{
  "name": "panel-arch",
  "kind": "py",
  "deterministic": true,
  "purpose": "Draw a arch panel as dark and light SVG in the Board look (or blueprint, paper): architecture boxes in ranks with packets flowing along the edges between them.",
  "examples": [
    "draw a arch panel",
    "a arch diagram of my project",
    "architecture boxes in ranks with packets flowing along the edges between them"
  ],
  "inputs": {
    "type": "object",
    "required": [
      "out",
      "title",
      "data"
    ],
    "additionalProperties": false,
    "properties": {
      "out": {
        "type": "string",
        "format": "newpath",
        "description": "the file stem: STEM-dark.svg and STEM-light.svg are written"
      },
      "title": {
        "type": "string",
        "minLength": 1,
        "maxLength": 40
      },
      "style": {
        "enum": [
          "board",
          "blueprint",
          "paper"
        ],
        "default": "board"
      },
      "stat": {
        "type": "string",
        "maxLength": 24
      },
      "foot": {
        "type": "string",
        "maxLength": 70
      },
      "w": {
        "type": "integer",
        "minimum": 420,
        "maximum": 2400,
        "default": 640
      },
      "h": {
        "type": "integer",
        "minimum": 260,
        "maximum": 1600,
        "default": 400
      },
      "data": {
        "type": "object",
        "properties": {
          "nodes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 16
                },
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 16
                },
                "sub": {
                  "type": "string",
                  "minLength": 0,
                  "maxLength": 22
                }
              },
              "required": [
                "id"
              ],
              "additionalProperties": false
            },
            "minItems": 2,
            "maxItems": 10
          },
          "edges": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "from": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 16
                },
                "to": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 16
                },
                "label": {
                  "type": "string",
                  "minLength": 0,
                  "maxLength": 12
                }
              },
              "required": [
                "from",
                "to"
              ],
              "additionalProperties": false
            },
            "minItems": 1,
            "maxItems": 16
          }
        },
        "required": [
          "nodes",
          "edges"
        ],
        "additionalProperties": false,
        "description": "the arch panel's data: nodes, edges"
      }
    }
  },
  "creates": [
    "$out-dark.svg",
    "$out-light.svg"
  ]
}

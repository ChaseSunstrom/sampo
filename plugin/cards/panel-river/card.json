{
  "name": "panel-river",
  "kind": "py",
  "deterministic": true,
  "purpose": "Draw a river panel as dark and light SVG in the Board look (or blueprint, paper): a timeline river: three streams carrying buoys, labelled by events in order.",
  "examples": [
    "draw a river panel",
    "a river diagram of my project",
    "a timeline river: three streams carrying buoys, labelled by events in order"
  ],
  "inputs": {
    "type": "object",
    "required": [
      "out",
      "title",
      "data"
    ],
    "additionalProperties": false,
    "properties": {
      "out": {
        "type": "string",
        "format": "newpath",
        "description": "the file stem: STEM-dark.svg and STEM-light.svg are written"
      },
      "title": {
        "type": "string",
        "minLength": 1,
        "maxLength": 40
      },
      "style": {
        "enum": [
          "board",
          "blueprint",
          "paper"
        ],
        "default": "board"
      },
      "stat": {
        "type": "string",
        "maxLength": 24
      },
      "foot": {
        "type": "string",
        "maxLength": 70
      },
      "w": {
        "type": "integer",
        "minimum": 420,
        "maximum": 2400,
        "default": 640
      },
      "h": {
        "type": "integer",
        "minimum": 260,
        "maximum": 1600,
        "default": 400
      },
      "data": {
        "type": "object",
        "properties": {
          "events": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 14
                },
                "lane": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 2
                }
              },
              "required": [
                "label"
              ],
              "additionalProperties": false
            },
            "minItems": 2,
            "maxItems": 8
          }
        },
        "required": [
          "events"
        ],
        "additionalProperties": false,
        "description": "the river panel's data: events"
      }
    }
  },
  "creates": [
    "$out-dark.svg",
    "$out-light.svg"
  ]
}
